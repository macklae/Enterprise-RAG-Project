# ---------- OpenAI (the writer) ----------
OPENAI_API_KEY=
# Set to a model your OpenAI account can use. Required for generated answers.
OPENAI_MODEL=

# ---------- Qdrant ----------
QDRANT_URL=http://localhost:6333
# Must match QDRANT_API_KEY used by docker compose
QDRANT_API_KEY=change-me-qdrant-key
QDRANT_COLLECTION=swiftpay_chunks

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_NOTFOUND_TTL_SECONDS=900
# Cosine distance. 0 = identical. Smaller is stricter.
CACHE_SEMANTIC_DISTANCE=0.1

# ---------- Embeddings ----------
EMBED_MODEL=BAAI/bge-m3
RERANKER_ENABLED=false
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ---------- Retrieval (tune with scripts/evaluate.py) ----------
RETRIEVE_TOP_K=20
FINAL_TOP_K=5
# Dense cosine floor used when the reranker is off
MIN_DENSE_SCORE=0.30
# Normalised reranker floor used when the reranker is on
MIN_RERANK_SCORE=0.05

# ---------- Chunking ----------
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=40

# ---------- Documents ----------
DOCUMENTS_DIR=data/documents
CONVERT_DOCX_TO_PDF=true
SOFFICE_BIN=soffice

# ---------- Guardrails ----------
MAX_QUERY_CHARS=1000
RATE_LIMIT_PER_MINUTE=30
# Restricted chunks are never sent to OpenAI unless you set this to true
SEND_RESTRICTED_TO_LLM=false
